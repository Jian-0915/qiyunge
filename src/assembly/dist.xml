<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>dist</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>

    <files>
        <!-- EXE 启动器 -->
        <file>
            <source>${project.build.directory}/栖云阁.exe</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <!-- fat JAR -->
        <file>
            <source>${project.build.directory}/qiyunge.jar</source>
            <outputDirectory>/</outputDirectory>
        </file>
    </files>

    <fileSets>
        <!-- NeteaseCloudMusicApi 工具（含 node_modules） -->
        <fileSet>
            <directory>${project.basedir}/tools/NeteaseCloudMusicApi</directory>
            <outputDirectory>/tools/NeteaseCloudMusicApi</outputDirectory>
            <excludes>
                <exclude>.git/**</exclude>
                <exclude>logs/**</exclude>
            </excludes>
        </fileSet>

        <!-- lib 目录（jlayer 等本地 JAR） -->
        <fileSet>
            <directory>${project.basedir}/lib</directory>
            <outputDirectory>/lib</outputDirectory>
        </fileSet>

        <!-- 捆绑 JRE（由 prepare-package 阶段复制到 target/jre） -->
        <fileSet>
            <directory>${project.build.directory}/jre</directory>
            <outputDirectory>/jre</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
